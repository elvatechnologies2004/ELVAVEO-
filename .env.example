# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development:
#   cp .env.example .env.local      (macOS / Linux)
#   copy .env.example .env.local    (Windows PowerShell)
#
# On Vercel: Project Settings > Environment Variables
#
# .env.example is committed on purpose. Never commit .env.local.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# SMTP & PYTHON EMAIL CONFIGURATION (Omucloud / Custom SMTP)
# ---------------------------------------------------------------------------
# Sender address (Configured for hello@elvaveo.com)
SENDER_EMAIL=hello@elvaveo.com
SENDER_NAME=ELVAVEO Website

# Recipient inbox that receives contact form submissions
CONTACT_EMAIL=hello@elvaveo.com

# SMTP Server details provided by your email host (Omucloud / Hostinger / AWS)
SMTP_HOST=smtp.omucloud.co
SMTP_PORT=587
SMTP_USER=hello@elvaveo.com
SMTP_PASS=your_email_password_here

# ---------------------------------------------------------------------------
# ADMIN CONSOLE AUTHENTICATION & SECURITY
# ---------------------------------------------------------------------------
# Master passcode required for Step 1 of Admin Portal authentication.
ADMIN_PASSWORD=Alfabravo669#

# 32+ character random secret used for HMAC-SHA256 session token signatures.
# In production, generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=elvaveo_sec_key_e4368204_9921_production_hardened

# ---------------------------------------------------------------------------
# SUPABASE CONFIGURATION (Credentials & RLS Database)
# ---------------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Public Anonymous API Key (used for safe public SELECT queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service Role Secret Key (SERVER-SIDE ONLY — NEVER EXPOSE TO BROWSER)
# Used by server-side APIs to verify admin credentials and write security audit logs.
SUPABASE_SERVICE_ROLE_KEY=
