# ---------------------------------------------------------------------------
# Copy to `.env.local` for local development:
#   cp .env.example .env.local      (macOS / Linux)
#   copy .env.example .env.local    (Windows PowerShell)
#
# On Vercel: Project Settings > Environment Variables
#
# .env.example is committed on purpose. Never commit .env.local.
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com > API Keys. Starts with "re_".
# SERVER-SIDE ONLY. Never prefix it with NEXT_PUBLIC_.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_EMAIL=hello@elvaveo.com

# Optional. Sender address for those emails.
# Leave unset until elvaveo.com is verified in Resend: the route then falls
# back to Resend's onboarding sender, which only delivers to your own account.
# After verification, set it to a real sender on your domain, e.g.:
#   RESEND_FROM_EMAIL="ELVAVEO <hello@elvaveo.com>"
RESEND_FROM_EMAIL=
