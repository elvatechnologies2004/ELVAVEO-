# dependencies
/node_modules

# next.js
/.next/
/out/
/next-env.d.ts

# production
/build

# local scratch scripts (not part of the site)
/_local

# personal editor / tooling config
.vscode/*
!.vscode/extensions.json
.idea

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets must never be committed.
# Order matters: git applies the LAST matching pattern, so the negation for
# the committed template must stay below every pattern that would catch it.
# `vercel link` appends a blanket `.env*`, which silently overrides the
# negation above and drops .env.example from the repo — re-check this file
# after running vercel link.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# vercel
.vercel

# misc
Thumbs.db
